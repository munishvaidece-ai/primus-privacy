# Settings for trying PRIMUS PRIVACY on your own computer (LOCAL_TESTING.md).
# `npm run local:setup` copies this to `.env` if you do not have one yet, and
# fills in CONNECTOR_SECRET_KEY for you.

# Your local database (started by `npm run local:db`).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/primus_local

# One-click sign-in for testing on this computer only. It refuses to work in a
# production build, with a non-local database, or when Supabase is configured.
# Delete this line when you move to real sign-in.
LOCAL_DEMO_AUTH=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Filled in automatically by `npm run local:setup`.
CONNECTOR_SECRET_KEY=

# The built-in rules engine: nothing leaves your computer.
AI_PROVIDER=offline
AI_EXTERNAL_ENABLED=false
