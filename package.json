{
  "name": "primus-privacy",
  "version": "0.1.0",
  "private": true,
  "description": "PRIMUS PRIVACY — DPDP advisory and continuous compliance platform. Milestone 1: database foundation (Identity + Tenancy + Engagement Structure) only. No product UI yet.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:apply": "tsx scripts/apply-migrations.ts",
    "db:seed": "tsx db/seed/roles.ts",
    "test:rls": "tsx scripts/reset-test-db.ts && vitest run tests/rls"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "pg": "8.12.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.5"
  }
}
