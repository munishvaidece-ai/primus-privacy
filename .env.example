# Copy to .env (or .env.local for Next.js) and fill in real values.
# Never commit a real .env file — see SECURITY.md §7.

# Server-only — the app's normal runtime database connection. In a real
# deployed Supabase project this would be the `authenticator` role
# Supabase provisions (restricted to SET ROLE anon/authenticated/
# service_role only); no such project has been provisioned yet
# (DECISIONS.md D-03), so local/dev environments point this at the local
# Postgres superuser instead, matching every migration/seed script since
# Milestone 1 — see lib/db/request-client.ts for what this does and does
# not mean for RLS enforcement. Never expose this to client-side code.
DATABASE_URL=postgres://user:password@localhost:5432/primus_privacy

# Server-only — used ONLY by trusted server-side code (e.g. the
# membership-grant service, migration runner). This is the Postgres role
# that bypasses RLS (Supabase's service_role key in production). Never
# reference this from a Server/Client Component that ships to the browser,
# and never log it. See SECURITY.md §7.
SUPABASE_SERVICE_ROLE_KEY=

# Public — safe to expose to the browser (Supabase's own convention for
# these two: the anon key is meant to be public, RLS is what actually
# protects data behind it). Used by lib/supabase/server.ts,
# lib/supabase/middleware.ts, and lib/auth/actions.ts for Supabase Auth
# session handling (PHASE A / Slice A1). No real Supabase project has
# been provisioned for this repository yet (DECISIONS.md D-03) — until
# these are set to real values, every route that requires
# authentication will fail with a clear configuration error rather than
# silently behaving as if signed in or fabricating a session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local RLS test suite only (tests/rls) — a local Postgres superuser
# connection used to provision the shimmed `auth` schema and test
# fixtures. Never used by application code. See tests/rls/README.md.
TEST_DATABASE_SUPERUSER_URL=postgres://postgres@localhost:5432/primus_privacy_test
