# Copy to .env (or .env.local for Next.js) and fill in real values.
# Never commit a real .env file — see SECURITY.md §7.

# Server-only — the app's normal runtime database connection. In a real
# deployed Supabase project this would be the `authenticator` role
# Supabase provisions (restricted to SET ROLE anon/authenticated/
# service_role only); no such project has been provisioned yet
# (DECISIONS.md D-03), so local/dev environments point this at the local
# Postgres superuser instead, matching every migration/seed script since
# Milestone 1 — see lib/db/request-client.ts for what this does and does
# not mean for RLS enforcement. Never expose this to client-side code.
DATABASE_URL=postgres://user:password@localhost:5432/primus_privacy

# Server-only — used ONLY by trusted server-side code (e.g. the
# membership-grant service, migration runner). This is the Postgres role
# that bypasses RLS (Supabase's service_role key in production). Never
# reference this from a Server/Client Component that ships to the browser,
# and never log it. See SECURITY.md §7.
SUPABASE_SERVICE_ROLE_KEY=

# Public — safe to expose to the browser (Supabase's own convention for
# these two: the anon key is meant to be public, RLS is what actually
# protects data behind it). Used by lib/supabase/server.ts,
# lib/supabase/middleware.ts, and lib/auth/actions.ts for Supabase Auth
# session handling (PHASE A / Slice A1), and — as of Slice C2 —
# lib/storage/evidence-storage.ts's getEvidenceStorageAdapter(), which
# checks this SAME pair to decide whether real Supabase Storage (via the
# same session-bound client Auth already uses, never a second Supabase
# architecture) or a local/test file-based stand-in should handle
# Evidence uploads. No real Supabase project has been provisioned for
# this repository yet (DECISIONS.md D-03) — until these are set to real
# values, every route that requires authentication will fail with a
# clear configuration error rather than silently behaving as if signed
# in or fabricating a session, and Evidence storage falls back to the
# local/test adapter (DECISIONS.md R-95).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local RLS test suite only (tests/rls) — a local Postgres superuser
# connection used to provision the shimmed `auth` schema and test
# fixtures. Never used by application code. See tests/rls/README.md.
TEST_DATABASE_SUPERUSER_URL=postgres://postgres@localhost:5432/primus_privacy_test

# Public — the app's own externally-reachable base URL. Introduced by
# Slice P2B.3 (Invitation Creation & Secure Token Lifecycle) for exactly
# one purpose so far: lib/domain/invitations.ts's own buildInvitationUrl()
# uses it to construct the `/invite/<token>` link handed to the (not yet
# real) invitation delivery boundary. Defaults to http://localhost:3000
# if unset, so local/dev/test use needs zero configuration. Carries no
# secret — safe to expose to the browser like NEXT_PUBLIC_SUPABASE_URL
# above.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# AI layer, connectors and the AI worker (added with the AI Operations Centre)
# See docs/DEPLOYMENT.md for what each setting does and what is required.
# =============================================================================

# --- AI engine --------------------------------------------------------------
# "offline" (default) = the built-in rules engine: NO data leaves your server.
# "anthropic" or "openai_compatible" = use an outside language model. An
# outside model is used ONLY when ALL of these hold: AI_EXTERNAL_ENABLED=true,
# a key and model are set, and the engagement's own "allow outside model"
# switch is on. Personal identifiers are masked before any text is sent.
AI_PROVIDER=offline
AI_EXTERNAL_ENABLED=false
AI_API_KEY=
AI_MODEL=
# Required for openai_compatible (e.g. a model you host in India or inside the
# client's environment); optional for anthropic.
AI_BASE_URL=
# Shown on screen as the headline guardrail, e.g. "India (Mumbai)" or
# "Client environment". Be truthful: it is what you tell the client.
AI_DATA_REGION=
AI_MAX_INPUT_CHARS=12000
AI_REQUEST_TIMEOUT_MS=60000
AI_WORKER_POLL_MS=2000
# How often the worker looks for new work on every enabled engagement (ms).
AI_PLAN_INTERVAL_MS=900000
# Optional: the worker answers GET /health on this port (for container probes).
WORKER_HEALTH_PORT=

# --- Connectors ---------------------------------------------------------------
# 32 random bytes, base64 or hex. Encrypts connector passwords/connection
# strings before they are stored. Generate: openssl rand -base64 32
# LOSING THIS KEY means saved connector credentials must be re-entered.
CONNECTOR_SECRET_KEY=
# Folder scans may read ONLY inside these mounted folders (comma-separated).
# Empty = folder scanning is switched off.
CONNECTOR_FOLDER_ROOTS=
# Website scans refuse private/internal addresses unless this is "true".
CONNECTOR_ALLOW_PRIVATE_HOSTS=false

# --- Storage the worker reads (only when Supabase is NOT configured) -----------
# Where evidence files were written by the app's local storage adapter.
EVIDENCE_LOCAL_ROOT=

# --- First-time setup only (scripts/bootstrap.ts) --------------------------------
# Password for the first administrator created in Supabase Auth. Remove after use.
BOOTSTRAP_ADMIN_PASSWORD=
